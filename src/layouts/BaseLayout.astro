---
import { fetchAllTransfers } from '../lib/fetchTransfers';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  keywords?: string;
  noindex?: boolean;
}

const {
  title = 'TransferHub',
  description = 'Live football transfer news, rumours and confirmed signings updated every 30 minutes. Premier League, La Liga, Serie A and Champions League transfers.',
  ogImage = '/og-default.png',
  canonicalUrl = Astro.url.href,
  type = 'website',
  publishedAt,
  keywords = 'football transfers, transfer news, transfer rumours, Premier League transfers, soccer transfers, confirmed signings, transfer window 2026, football transfer news today, done deals',
  noindex = false,
} = Astro.props;

const fullTitle = title === 'TransferHub'
  ? 'TransferHub | Live Football Transfer News & Rumours 2026'
  : `${title} | TransferHub`;

const SITE = 'https://transferhub.club';

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TransferHub',
  url: SITE,
  logo: `${SITE}/icons/icon-192.png`,
});

const siteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TransferHub',
  url: SITE,
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE}/search?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
});

// Ticker data — lead with confirmed transfers, top up with latest so it never looks empty
const allTransfers = await fetchAllTransfers();
const confirmedTransfers = allTransfers.filter(t => t.type === 'confirmed');
const filler = allTransfers.filter(t => t.type !== 'confirmed');
const tickerItems = [...confirmedTransfers, ...filler].slice(0, 12);
// Duplicate the list so the marquee can loop seamlessly
const tickerLoop = [...tickerItems, ...tickerItems];
const tickerLabel = confirmedTransfers.length ? 'CONFIRMED' : 'LATEST';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0c1f14" />
    <meta name="color-scheme" content="dark" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="TransferHub" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png" />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="TransferHub" />
    <meta property="og:locale" content="en_GB" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@TransferHubFC" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}${ogImage}`} />

    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://www.thesportsdb.com" />

    <!-- Editorial headline font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500;6..72,600;6..72,700&display=swap" />

    <script type="application/ld+json" set:html={orgSchema} />
    <script type="application/ld+json" set:html={siteSchema} />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3597619614312770" crossorigin="anonymous"></script>

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>

    <!-- Per-page structured data (ItemList, FAQPage, etc.) -->
    <slot name="head" />
  </head>

  <body class="min-h-full bg-pitch-800 text-cream flex flex-col">

    <!-- Scrolling ticker (confirmed transfers) -->
    {tickerItems.length > 0 && (
      <div class="bg-pitch-900 border-b border-line-soft overflow-hidden">
        <div class="max-w-6xl mx-auto flex items-stretch h-9">
          <!-- Fixed label -->
          <div class="flex items-center gap-1.5 flex-shrink-0 bg-gold text-pitch-900 px-3 z-10">
            <span class="w-1.5 h-1.5 rounded-full bg-pitch-900 animate-pulse"></span>
            <span class="text-[11px] font-black tracking-widest uppercase">{tickerLabel}</span>
          </div>
          <!-- Moving track -->
          <div class="ticker-mask relative flex-1 overflow-hidden flex items-center">
            <div class="ticker-track flex items-center gap-8 whitespace-nowrap pl-6">
              {tickerLoop.map((t, i) => (
                <a
                  href={t.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-2 flex-shrink-0"
                  aria-hidden={i >= tickerItems.length ? 'true' : undefined}
                >
                  {t.type === 'confirmed' ? (
                    <svg class="w-3.5 h-3.5 text-grass flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                  ) : (
                    <span class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${t.type === 'rumour' ? 'bg-rumor' : 'bg-info'}`}></span>
                  )}
                  <span class="text-[12px] text-cream-muted group-hover:text-cream transition-colors">{t.title}</span>
                  <span class="text-[11px] text-cream-dim font-medium">{t.source}</span>
                  <span class="text-line">&bull;</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Header -->
    <header class="sticky top-0 z-50 bg-pitch-800/95 backdrop-blur border-b border-line shadow-lg shadow-black/20">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between gap-6">

        <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
          <div class="w-7 h-7 flex-shrink-0">
            <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
              <rect width="32" height="32" rx="8" fill="#d4af37"/>
              <path d="M7 16h18M17 9l8 7-8 7" stroke="#0c1f14" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-black text-[17px] tracking-tight text-cream group-hover:text-gold transition-colors">
            Transfer<span class="text-gold">Hub</span>
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
          <a href="/" class="px-3 py-1.5 rounded-lg text-cream-muted hover:text-cream hover:bg-pitch-600 transition-all">Latest</a>
          <a href="/news" class="px-3 py-1.5 rounded-lg text-cream-muted hover:text-cream hover:bg-pitch-600 transition-all">News</a>
          <a href="/confirmed" class="px-3 py-1.5 rounded-lg text-cream-muted hover:text-cream hover:bg-pitch-600 transition-all flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-grass flex-shrink-0"></span>Confirmed
          </a>
          <a href="/rumours" class="px-3 py-1.5 rounded-lg text-cream-muted hover:text-cream hover:bg-pitch-600 transition-all flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-rumor flex-shrink-0"></span>Rumours
          </a>
          <div class="relative group">
            <button class="px-3 py-1.5 rounded-lg text-cream-muted hover:text-cream group-hover:bg-pitch-600 group-focus-within:bg-pitch-600 transition-all flex items-center gap-1" aria-haspopup="true">
              Leagues
              <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block group-focus-within:block z-50">
              <div class="bg-pitch-700 border border-line rounded-lg shadow-xl shadow-black/40 py-1 min-w-[168px]">
                <a href="/premier-league" class="block px-4 py-2 text-cream-muted hover:text-cream hover:bg-pitch-600 transition-colors">Premier League</a>
                <a href="/league/la-liga" class="block px-4 py-2 text-cream-muted hover:text-cream hover:bg-pitch-600 transition-colors">La Liga</a>
                <a href="/league/serie-a" class="block px-4 py-2 text-cream-muted hover:text-cream hover:bg-pitch-600 transition-colors">Serie A</a>
                <a href="/league/bundesliga" class="block px-4 py-2 text-cream-muted hover:text-cream hover:bg-pitch-600 transition-colors">Bundesliga</a>
                <a href="/league/ligue-1" class="block px-4 py-2 text-cream-muted hover:text-cream hover:bg-pitch-600 transition-colors">Ligue 1</a>
              </div>
            </div>
          </div>
          <a href="/clubs" class="px-3 py-1.5 rounded-lg text-cream-muted hover:text-cream hover:bg-pitch-600 transition-all">Clubs</a>
          <a href="/guides" class="px-3 py-1.5 rounded-lg text-cream-muted hover:text-cream hover:bg-pitch-600 transition-all">Guides</a>
          <a href="/about" class="px-3 py-1.5 rounded-lg text-cream-muted hover:text-cream hover:bg-pitch-600 transition-all">About</a>
        </nav>

        <button id="menu-btn" class="md:hidden p-2 -mr-2 rounded-lg text-cream-muted hover:text-cream hover:bg-pitch-600 transition-all" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Mobile menu (toggled) -->
      <div id="mobile-menu" class="md:hidden hidden border-t border-line bg-pitch-800">
        <nav class="max-w-6xl mx-auto px-2 py-2 flex flex-col text-[15px] font-medium">
          <a href="/" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">Latest</a>
          <a href="/news" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">News</a>
          <a href="/confirmed" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-grass flex-shrink-0"></span>Confirmed
          </a>
          <a href="/rumours" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-rumor flex-shrink-0"></span>Rumours
          </a>
          <p class="px-3 pt-3 pb-1 text-[11px] font-bold uppercase tracking-widest text-cream-dim">Leagues</p>
          <a href="/premier-league" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">Premier League</a>
          <a href="/league/la-liga" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">La Liga</a>
          <a href="/league/serie-a" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">Serie A</a>
          <a href="/league/bundesliga" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">Bundesliga</a>
          <a href="/league/ligue-1" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">Ligue 1</a>
          <div class="h-px bg-line-soft my-1 mx-3"></div>
          <a href="/clubs" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">Clubs</a>
          <a href="/guides" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">Guides</a>
          <a href="/about" class="px-3 py-3 rounded-lg text-cream hover:bg-pitch-600 transition-all">About</a>
        </nav>
      </div>
    </header>

    <script is:inline>
      (function () {
        var btn = document.getElementById('menu-btn');
        var menu = document.getElementById('mobile-menu');
        var io = document.getElementById('menu-icon-open');
        var ic = document.getElementById('menu-icon-close');
        if (!btn || !menu) return;
        btn.addEventListener('click', function () {
          var open = menu.classList.toggle('hidden') === false;
          btn.setAttribute('aria-expanded', String(open));
          io.classList.toggle('hidden', open);
          ic.classList.toggle('hidden', !open);
        });
      })();
    </script>

    <main class="flex-1 max-w-6xl mx-auto w-full px-4 py-6">
      <slot />
    </main>

    <!-- Attribution banner (copyright compliance) -->
    <div class="bg-pitch-700 border-t border-line">
      <div class="max-w-6xl mx-auto px-4 py-3 text-xs text-cream-muted leading-relaxed">
        <strong class="text-gold">Content Attribution:</strong> All news articles displayed on TransferHub are sourced from and remain the property of their respective publishers (Sky Sports, BBC Sport, ESPN, Goal.com, The Guardian, Football365). TransferHub aggregates publicly available RSS feeds and links directly to original articles. No article text is reproduced in full.
        <a href="/attribution" class="underline ml-1 text-gold hover:text-gold-400">Full attribution policy</a>
      </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-line bg-pitch-900">
      <div class="max-w-6xl mx-auto px-4 py-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-sm text-cream-muted">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <div class="w-5 h-5 flex-shrink-0">
              <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                <rect width="32" height="32" rx="8" fill="#d4af37"/>
                <path d="M7 16h18M17 9l8 7-8 7" stroke="#0c1f14" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="font-black text-cream text-base tracking-tight">TransferHub</span>
          </div>
          <p class="leading-relaxed">Real-time football transfer news aggregated from trusted publishers. We link directly to every original article.</p>
          <p class="mt-2 text-xs text-cream-dim">Sources: Sky Sports, BBC Sport, ESPN, Goal.com, The Guardian, Football365</p>
        </div>
        <div>
          <p class="font-semibold text-cream mb-3 uppercase text-xs tracking-wider">Sections</p>
          <ul class="space-y-2">
            <li><a href="/" class="hover:text-gold transition-colors">Latest Transfers</a></li>
            <li><a href="/news" class="hover:text-gold transition-colors">Football News</a></li>
            <li><a href="/confirmed" class="hover:text-gold transition-colors">Confirmed Signings</a></li>
            <li><a href="/rumours" class="hover:text-gold transition-colors">Transfer Rumours</a></li>
            <li><a href="/premier-league" class="hover:text-gold transition-colors">Premier League</a></li>
            <li><a href="/clubs" class="hover:text-gold transition-colors">Browse by Club</a></li>
            <li><a href="/guides" class="hover:text-gold transition-colors">Transfer Guides</a></li>
            <li><a href="/about" class="hover:text-gold transition-colors">About Us</a></li>
            <li><a href="/methodology" class="hover:text-gold transition-colors">How We Rate</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-cream mb-3 uppercase text-xs tracking-wider">Leagues</p>
          <ul class="space-y-2">
            <li><a href="/premier-league" class="hover:text-gold transition-colors">Premier League</a></li>
            <li><a href="/league/la-liga" class="hover:text-gold transition-colors">La Liga</a></li>
            <li><a href="/league/serie-a" class="hover:text-gold transition-colors">Serie A</a></li>
            <li><a href="/league/bundesliga" class="hover:text-gold transition-colors">Bundesliga</a></li>
            <li><a href="/league/ligue-1" class="hover:text-gold transition-colors">Ligue 1</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-cream mb-3 uppercase text-xs tracking-wider">Legal</p>
          <ul class="space-y-2">
            <li><a href="/attribution" class="hover:text-gold transition-colors">Attribution Policy</a></li>
            <li><a href="/privacy" class="hover:text-gold transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-gold transition-colors">Terms of Service</a></li>
            <li><a href="/disclaimer" class="hover:text-gold transition-colors">Disclaimer</a></li>
            <li><a href="/credits" class="hover:text-gold transition-colors">Image Credits</a></li>
            <li><a href="/contact" class="hover:text-gold transition-colors">Contact / DMCA</a></li>
            <li><a href="#" onclick="if(window.googlefc&&googlefc.showRevocationMessage){googlefc.showRevocationMessage();return false;}" class="hover:text-gold transition-colors">Cookie settings</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-line-soft py-4 text-center text-xs text-cream-dim">
        &copy; {new Date().getFullYear()} TransferHub &mdash; News aggregated from public RSS feeds &mdash; All article rights belong to respective publishers
      </div>
    </footer>

  </body>
</html>

<style>
  /* Marquee ticker — duplicated content scrolls -50% for a seamless loop */
  .ticker-track {
    animation: ticker-scroll 85s linear infinite;
    will-change: transform;
  }
  @media (max-width: 640px) {
    /* slower still on mobile so it's readable */
    .ticker-track { animation-duration: 70s; }
  }
  .ticker-mask:hover .ticker-track {
    animation-play-state: paused;
  }
  /* Soft fade at both edges */
  .ticker-mask {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 24px), transparent);
            mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 24px), transparent);
  }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }
</style>
