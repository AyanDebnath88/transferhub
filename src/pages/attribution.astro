---
import BaseLayout from '../layouts/BaseLayout.astro';

const sources = [
  {
    name: 'Sky Sports',
    url: 'https://www.skysports.com/transfer-news',
    feed: 'https://www.skysports.com/rss/12040',
    description: 'Breaking transfer news and exclusive reports from Sky Sports Football.',
  },
  {
    name: 'BBC Sport',
    url: 'https://www.bbc.co.uk/sport/football/transfers',
    feed: 'https://feeds.bbci.co.uk/sport/football/rss.xml',
    description: 'Transfer news and confirmed signings from BBC Sport.',
  },
  {
    name: 'ESPN FC',
    url: 'https://www.espn.co.uk/football/',
    feed: 'https://www.espn.co.uk/espn/rss/football/news',
    description: 'Transfer news and analysis from ESPN Football.',
  },
  {
    name: 'Goal.com',
    url: 'https://www.goal.com/en-gb/transfer-news',
    feed: 'https://www.goal.com/feeds/en/news',
    description: 'Global football transfer news and rumours.',
  },
  {
    name: 'The Guardian',
    url: 'https://www.theguardian.com/football/transfers',
    feed: 'https://www.theguardian.com/football/transfers/rss',
    description: 'Transfer news and football journalism from The Guardian.',
  },
  {
    name: 'Football365',
    url: 'https://www.football365.com/transfer-news',
    feed: 'https://www.football365.com/feed',
    description: 'Transfer news and commentary from Football365.',
  },
];
---

<BaseLayout
  title="Attribution Policy | TransferHub"
  description="TransferHub content attribution policy. All news articles are sourced from and remain the property of their respective publishers."
>
  <div class="max-w-3xl">
    <h1 class="font-display text-3xl sm:text-4xl font-bold text-cream mb-2">Attribution Policy</h1>
    <p class="text-cream-dim mb-8 text-sm">Last updated: 28 June 2026</p>

    <!-- Intro -->
    <div class="bg-gold/10 border border-gold/30 rounded-xl p-5 mb-8">
      <p class="text-sm text-cream leading-relaxed">
        <strong class="text-gold">TransferHub is a news aggregator.</strong> We do not produce original content. All articles, headlines, summaries and images displayed on this site are sourced from the publishers listed below via their publicly available RSS feeds. Every story links directly to the original article on the publisher's website. No article text is reproduced in full.
      </p>
    </div>

    <!-- How it works -->
    <section class="mb-10">
      <h2 class="font-display text-xl font-bold text-cream mb-4">How We Aggregate Content</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        {[
          { step: '1', title: 'RSS Feed', body: 'We poll each publisher\'s public RSS feed every 30 minutes to discover new articles.' },
          { step: '2', title: 'Headlines Only', body: 'We display the headline, a brief excerpt, and a thumbnail image — exactly as provided in the RSS feed.' },
          { step: '3', title: 'Click Through', body: 'Every card links directly to the original article. Readers visit the publisher\'s site to read the full story.' },
        ].map(item => (
          <div class="bg-pitch-700 border border-line rounded-xl p-4">
            <div class="w-7 h-7 rounded-full bg-gold/15 text-gold font-black text-sm flex items-center justify-center mb-3">{item.step}</div>
            <p class="text-sm font-bold text-cream mb-1">{item.title}</p>
            <p class="text-xs text-cream-muted leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-10">
      <h2 class="font-display text-xl font-bold text-cream mb-4">Content Sources</h2>
      <div class="space-y-3">
        {sources.map(source => (
          <div class="bg-pitch-700 border border-line rounded-xl p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
              <a href={source.url} target="_blank" rel="noopener noreferrer"
                 class="text-sm font-bold text-cream hover:text-gold transition-colors">
                {source.name}
              </a>
              <p class="text-xs text-cream-muted mt-0.5 leading-relaxed">{source.description}</p>
            </div>
            <a href={source.url} target="_blank" rel="noopener noreferrer"
               class="flex-shrink-0 text-xs bg-gold/15 hover:bg-gold/25 text-gold font-semibold px-3 py-1.5 rounded-lg transition-colors whitespace-nowrap">
              Visit Publisher
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Copyright -->
    <section class="mb-10">
      <h2 class="font-display text-xl font-bold text-cream mb-3">Copyright Notice</h2>
      <div class="bg-pitch-700 border border-line rounded-xl p-5 space-y-3 text-sm text-cream-muted leading-relaxed">
        <p>All article titles, summaries, images and other content displayed on TransferHub remain the exclusive intellectual property of their respective publishers. TransferHub claims no ownership over any third-party content.</p>
        <p>Our aggregation is based on the principle of fair use / fair dealing, as we reproduce only minimal extracts (headlines and short excerpts) and direct users to the original source for the full article — thereby driving traffic to publishers rather than replacing them.</p>
        <p>Publisher logos, trademarks and brand identities referenced or displayed on this site remain the property of their respective owners and are used solely for identification purposes.</p>
      </div>
    </section>

    <!-- DMCA -->
    <section class="mb-8">
      <h2 class="font-display text-xl font-bold text-cream mb-3">Takedown / DMCA Requests</h2>
      <div class="bg-pitch-700 border border-line rounded-xl p-5 text-sm text-cream-muted leading-relaxed">
        <p>If you are a copyright holder and believe that content aggregated by TransferHub infringes your rights, please contact us at <a href="mailto:hello@transferhub.net" class="text-gold hover:underline">hello@transferhub.net</a> with the following information:</p>
        <ul class="mt-3 space-y-1 list-disc list-inside text-cream-muted">
          <li>Your name and contact information</li>
          <li>The URL of the content on TransferHub you wish to have removed</li>
          <li>A statement that you are the rights holder or authorised to act on their behalf</li>
        </ul>
        <p class="mt-3">We will remove the relevant content within <strong class="text-cream">24 hours</strong> of receiving a valid request.</p>
      </div>
    </section>

    <p class="text-xs text-cream-dim">
      Questions? <a href="/contact" class="text-gold hover:underline">Contact us</a> or see our <a href="/privacy" class="text-gold hover:underline">privacy policy</a>.
    </p>
  </div>
</BaseLayout>
