---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="TransferHub — Live Football Transfer News, Rumours & Results"
  description="Choose your feed: live football transfer news and confirmed done deals, or the day's football news, results and headlines from Europe's top five leagues."
  keywords="football transfer news, football news today, transfer rumours, done deals, league tables, premier league"
>
  <div class="relative overflow-hidden">
    <!-- decorative glow blobs behind the glass -->
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-24 -left-16 w-80 h-80 rounded-full bg-gold/20 blur-3xl"></div>
      <div class="absolute top-40 right-0 w-96 h-96 rounded-full bg-grass/15 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/3 w-72 h-72 rounded-full bg-info/15 blur-3xl"></div>
    </div>

    <div class="text-center max-w-2xl mx-auto pt-6 pb-10">
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-cream leading-tight">
        What are you here for?
      </h1>
      <p class="text-cream-muted mt-3 text-sm sm:text-base leading-relaxed">
        The window is closing and the leagues are back. Pick a feed, both are live and updated through the day.
      </p>
    </div>

    <!-- two glass choices -->
    <div class="grid sm:grid-cols-2 gap-5 max-w-3xl mx-auto">
      <a href="/transfers"
         class="group relative rounded-3xl border border-white/10 bg-white/5 backdrop-blur-xl p-7 hover:border-gold/50 hover:bg-white/[0.08] transition-all">
        <div class="w-12 h-12 rounded-2xl bg-gold/15 border border-gold/30 flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </div>
        <h2 class="font-display text-2xl font-bold text-cream mb-2">Transfer News</h2>
        <p class="text-sm text-cream-muted leading-relaxed">Confirmed signings, done deals and the latest rumours, rated for reliability. Plus the biggest clubs' top moves of the window.</p>
        <span class="inline-flex items-center gap-1 text-gold text-sm font-semibold mt-5 group-hover:gap-2 transition-all">Open transfers <span aria-hidden="true">&rarr;</span></span>
      </a>

      <a href="/news"
         class="group relative rounded-3xl border border-white/10 bg-white/5 backdrop-blur-xl p-7 hover:border-grass/50 hover:bg-white/[0.08] transition-all">
        <div class="w-12 h-12 rounded-2xl bg-grass/15 border border-grass/30 flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-grass" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V6m0 12v-2m0-6a9 9 0 110 0z"/></svg>
        </div>
        <h2 class="font-display text-2xl font-bold text-cream mb-2">Football News</h2>
        <p class="text-sm text-cream-muted leading-relaxed">Results, match reaction, injuries and the controversial calls from the top five leagues and the biggest teams.</p>
        <span class="inline-flex items-center gap-1 text-grass text-sm font-semibold mt-5 group-hover:gap-2 transition-all">Open news <span aria-hidden="true">&rarr;</span></span>
      </a>
    </div>

    <!-- quick links -->
    <div class="flex flex-wrap justify-center gap-2 max-w-3xl mx-auto mt-6">
      {[
        { href: '/tables', label: 'League Tables' },
        { href: '/confirmed', label: 'Confirmed Deals' },
        { href: '/rumours', label: 'Rumours' },
        { href: '/premier-league', label: 'Premier League' },
        { href: '/guides', label: 'Guides' },
      ].map((l) => (
        <a href={l.href} class="rounded-full border border-white/10 bg-white/5 backdrop-blur-md px-4 py-2 text-xs font-semibold text-cream-muted hover:text-cream hover:border-gold/40 transition-all">{l.label}</a>
      ))}
    </div>
  </div>
</BaseLayout>
