---
import BaseLayout from '../layouts/BaseLayout.astro';
import TransferCard from '../components/TransferCard.astro';
import { fetchAllTransfers } from '../lib/fetchTransfers';
import WindowBanner from '../components/WindowBanner.astro';

const all = await fetchAllTransfers();
const transfers = all.filter(t => t.type === 'rumour');
const updatedAt = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
---

<BaseLayout
  title="Football Transfer Rumours 2026 | Latest Links & Speculation"
  description={`${transfers.length} active football transfer rumours and links. Who's moving where? The latest speculation from Sky Sports, BBC, ESPN, Goal.com and The Guardian. Updated at ${updatedAt}.`}
  keywords="transfer rumours 2026, football transfer links, who is moving, transfer speculation, Premier League rumours, transfer gossip 2026"
>
  <WindowBanner />
  <div class="mb-6">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
      <div>
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-cream leading-none tracking-tight">
          Transfer <span class="text-rumor">Rumours</span>
        </h1>
        <p class="text-sm text-cream-muted mt-1.5">
          <span class="text-rumor font-semibold">{transfers.length}</span> active rumours &nbsp;&middot;&nbsp; Updated <time>{updatedAt}</time>
        </p>
      </div>
      <div class="flex gap-2">
        <a href="/transfers" class="bg-pitch-700 border border-line hover:border-gold/50 text-cream-muted hover:text-cream text-xs font-semibold px-3 py-1.5 rounded-lg transition-all">&larr; All News</a>
        <a href="/confirmed" class="flex items-center gap-1.5 bg-pitch-700 border border-line hover:border-grass/50 text-cream-muted hover:text-cream text-xs font-semibold px-3 py-1.5 rounded-lg transition-all">
          <span class="w-1.5 h-1.5 rounded-full bg-grass"></span> Confirmed
        </a>
      </div>
    </div>

    <div class="flex gap-1 bg-pitch-700 border border-line rounded-xl p-1 overflow-x-auto">
      {([
        { href: '/transfers',               label: 'All News',       active: false },
        { href: '/confirmed',      label: 'Confirmed',      active: false },
        { href: '/rumours',        label: 'Rumours',        active: true  },
        { href: '/premier-league', label: 'Premier League', active: false },
      ] as const).map(tab => (
        <a href={tab.href}
           class={`flex-shrink-0 px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap ${tab.active ? 'bg-gold text-pitch-900' : 'text-cream-muted hover:text-cream hover:bg-pitch-600'}`}>
          {tab.label}
        </a>
      ))}
    </div>
  </div>

  {transfers.length === 0 ? (
    <div class="text-center py-24">
      <p class="text-lg font-semibold text-cream-muted">No rumours at the moment</p>
      <p class="text-sm text-cream-dim mt-2">Check back soon — the rumour mill never stops for long.</p>
      <a href="/transfers" class="mt-6 inline-block bg-gold hover:bg-gold-400 text-pitch-900 text-sm font-semibold px-5 py-2 rounded-lg transition-colors">View All News</a>
    </div>
  ) : (
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {transfers.map(t => <TransferCard transfer={t} />)}
    </div>
  )}
</BaseLayout>
