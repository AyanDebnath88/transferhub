---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Server Error" description="Something went wrong on our end." noindex={true}>
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center py-20">
    <p class="font-display text-8xl font-bold text-gold/30 mb-6 tracking-tight select-none">500</p>
    <h1 class="text-xl font-bold text-cream mb-2">Something went wrong</h1>
    <p class="text-cream-muted mb-8 max-w-sm text-sm leading-relaxed">
      Our feed aggregator hit a temporary issue. Transfer news will be back shortly.
    </p>
    <a href="/" class="bg-gold hover:bg-gold-400 text-pitch-900 text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors">
      Back to Home
    </a>
  </div>
</BaseLayout>
