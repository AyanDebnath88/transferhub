---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="No Connection" description="No internet connection." noindex={true}>
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center py-20">
    <div class="w-12 h-12 mx-auto mb-5 text-gold/40">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M3 3l18 18M9.879 3.879A7.5 7.5 0 0121 12m-3.07 3.07A7.5 7.5 0 013 12m2.458-4.542A10.5 10.5 0 0121 12M3 12a10.5 10.5 0 014.121-8.121M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
    </div>
    <h1 class="text-xl font-bold text-cream mb-2">No connection</h1>
    <p class="text-cream-muted mb-8 max-w-sm text-sm leading-relaxed">
      Transfer news will load when your connection returns. Cached stories are still available.
    </p>
    <button
      onclick="window.location.reload()"
      class="bg-gold hover:bg-gold-400 text-pitch-900 text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors"
    >
      Try Again
    </button>
  </div>
</BaseLayout>
