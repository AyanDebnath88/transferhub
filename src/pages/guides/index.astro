---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES } from '../../data/guides';
---
<BaseLayout
  title="Football Transfer Guides & Explainers"
  description="In-depth guides to how football transfers work — the transfer window, fees and add-ons, loan deals, free transfers, financial rules (FFP/PSR) and how to read transfer rumours."
  keywords="transfer window explained, transfer fees explained, loan deals, Bosman ruling, FFP PSR explained, transfer rumours reliability"
>
  <div class="max-w-3xl">
    <h1 class="font-display text-3xl sm:text-4xl font-bold text-cream mb-2">Transfer Guides</h1>
    <p class="text-cream-muted mb-8 text-sm leading-relaxed">
      Original explainers on how the transfer market actually works — the rules, the money and the language behind the
      headlines. Written by TransferHub to help you read the window like an insider.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      {GUIDES.map((g) => (
        <a href={`/guides/${g.slug}`} class="block bg-pitch-700 border border-line rounded-xl p-5 hover:border-gold/50 transition-all">
          <h2 class="font-display text-lg font-bold text-cream leading-snug mb-2">{g.title}</h2>
          <p class="text-xs text-cream-muted leading-relaxed line-clamp-3">{g.description}</p>
          <p class="text-[11px] text-cream-dim mt-3">{g.readMins} min read</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
