---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClubBadge from '../components/ClubBadge.astro';
import { CLUB_META } from '../lib/clubs';
import { fetchAllTransfers } from '../lib/fetchTransfers';

function slugify(s: string): string {
  return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const all = await fetchAllTransfers();
const clubs = Object.keys(CLUB_META).map((name) => ({
  name,
  slug: slugify(name),
  count: all.filter((t) => t.clubs.includes(name)).length,
})).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<BaseLayout
  title="Football Clubs — Transfer News by Club 2026"
  description="Browse football transfer news by club. Arsenal, Chelsea, Liverpool, Manchester City, Manchester United, Real Madrid, Barcelona and more — confirmed signings and rumours for every top club."
  keywords="club transfer news, Arsenal transfers, Chelsea transfers, Liverpool transfers, Real Madrid transfers, Barcelona transfers, football club signings 2026"
>
  <div class="mb-8">
    <h1 class="font-display text-3xl sm:text-4xl font-bold text-cream leading-none tracking-tight">
      Transfer News by <span class="text-gold">Club</span>
    </h1>
    <p class="text-sm text-cream-muted mt-1.5">Pick a club for its confirmed signings, rumours and done deals.</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
    {clubs.map((c) => (
      <a
        href={`/club/${c.slug}`}
        class="group flex items-center gap-3 bg-pitch-700 border border-line hover:border-gold/50 rounded-xl p-3 transition-all"
      >
        <ClubBadge name={c.name} size="md" />
        <div class="min-w-0">
          <p class="text-sm font-semibold text-cream group-hover:text-gold transition-colors truncate">{c.name}</p>
          <p class="text-[11px] text-cream-dim">{c.count} {c.count === 1 ? 'story' : 'stories'}</p>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
