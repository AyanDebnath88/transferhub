---
import type { Transfer } from '../lib/types';
import ClubBadge from './ClubBadge.astro';
import ReliabilityStars from './ReliabilityStars.astro';
import { resolvePlayer, clubPhoto, clubImage, clubSlugForImage, genericPhoto, getCredit } from '../lib/images';

interface Props {
  transfer: Transfer;
  featured?: boolean;
}
const { transfer, featured = false } = Astro.props;

const typeConfig = {
  confirmed: { label: 'Confirmed',  cls: 'bg-grass/15 text-grass border border-grass/30' },
  rumour:    { label: 'Rumour',     cls: 'bg-rumor/15 text-rumor border border-rumor/30' },
  news:      { label: 'News',       cls: 'bg-info/15  text-info  border border-info/30' },
}[transfer.type];

function timeAgo(dateStr: string): string {
  const ts = new Date(dateStr).getTime();
  if (!dateStr || isNaN(ts)) return 'recently';
  const diff = Date.now() - ts;
  if (diff < 0) return 'just now';
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  return `${Math.floor(hrs / 24)}d ago`;
}

const ago = timeAgo(transfer.publishedAt);
const isBreaking = (() => {
  const ts = new Date(transfer.publishedAt).getTime();
  return !isNaN(ts) && Date.now() - ts < 2 * 60 * 60 * 1000;
})();

// Badges reflect the HEADLINE clubs only, so a card never implies a transfer
// between clubs that were merely mentioned in passing in the article body.
const fromClub = transfer.headlineClubs[0] ?? null;
const toClub   = transfer.headlineClubs[1] ?? null;

const gradient =
  transfer.type === 'confirmed' ? 'bg-gradient-to-br from-pitch-600 to-pitch-700' :
  transfer.type === 'rumour'    ? 'bg-gradient-to-br from-pitch-600 to-pitch-700' :
                                  'bg-gradient-to-br from-pitch-600 to-pitch-700';

const hasSummary = transfer.summary && transfer.summary !== transfer.title;

// Copyright-free card art (public/cards/) as the always-present base.
const CARD_ART = 12;
let h = 0;
for (const c of transfer.id) h = (h * 31 + c.charCodeAt(0)) | 0;
const cardArt = `/cards/${Math.abs(h) % CARD_ART}.svg`;

// Card image priority:
//   1. player photo (public/players) — full-bleed cover
//   2. club emblem (public/crests)   — centred, when no player photo
//   3. royalty-free Pixabay generic  — full-bleed cover, when neither
//   4. vector art alone
// Match a player photo by extracted names OR by scanning the headline (handles
// mononyms like "Rodri" and surnames that don't equal the full filename).
// Image priority (every card ends with a real photo — never image-less):
//   1. player photo (headline/name match)
//   2. real club PHOTO for any named club (rotates by id)
//   3. royalty-free generic
// Club crest emblem is a last-resort contain layer only if no photo at all.
const playerRes = resolvePlayer(transfer.players, transfer.title, transfer.summary);
const playerHit = playerRes?.src ?? null;
const playerName = playerRes ? playerRes.slug.replace(/-/g, ' ') : '';
const clubPhotoRes = playerHit ? null : clubPhoto(transfer.clubs, transfer.id);
const coverPhoto = playerHit ?? clubPhotoRes?.src ?? genericPhoto(transfer.id);
const clubHit = coverPhoto ? null : clubImage(transfer.headlineClubs);
// Attribution for whichever real image is shown.
const playerCredit = playerRes ? getCredit(playerRes.slug) : null;
const clubPhotoCredit = clubPhotoRes ? getCredit(clubPhotoRes.slug) : null;
const clubCreditSlug = clubHit ? clubSlugForImage(transfer.headlineClubs) : null;
const imgCredit = playerCredit ?? clubPhotoCredit ?? (clubCreditSlug ? getCredit(clubCreditSlug) : null);
---

<article class={`group relative bg-pitch-700 rounded-xl border border-line overflow-hidden transition-all duration-200 hover:border-gold/50 hover:shadow-lg hover:shadow-black/30 ${featured ? 'md:flex' : ''}`}>

  <!-- Breaking accent -->
  {isBreaking && (
    <div class="absolute top-0 left-0 right-0 h-[3px] bg-gold z-10"></div>
  )}

  <!-- Image area — original copyright-free card art (no agency photos).
       Gradient base sits behind as the final fallback. -->
  <div class={`relative overflow-hidden flex-shrink-0 aspect-[16/9] ${featured ? 'md:w-80 md:aspect-auto md:min-h-[200px]' : ''}`}>
    <div class={`absolute inset-0 flex items-end p-3 ${gradient}`}>
      <span class="text-[11px] font-bold text-cream-dim uppercase tracking-widest">{transfer.source}</span>
    </div>
    <!-- Vector art base (always present) -->
    <img
      src={cardArt}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <!-- Real photo overlay (player drop-in or royalty-free generic); hides itself if missing -->
    {coverPhoto && (
      <img
        src={coverPhoto}
        alt={playerHit ? playerName : ''}
        aria-hidden={playerHit ? undefined : 'true'}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
        onerror="this.style.display='none'"
      />
    )}
    <!-- Club emblem fallback (original crest) when no player photo -->
    {clubHit && (
      <img
        src={clubHit}
        alt={fromClub ?? ''}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-contain p-8 opacity-90 group-hover:scale-[1.03] transition-transform duration-500"
      />
    )}
    {imgCredit && (
      <a
        href={imgCredit.url}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="absolute bottom-1 right-1.5 text-[8px] text-white/70 hover:text-white bg-black/45 px-1 rounded z-10"
        title={`${imgCredit.author} — ${imgCredit.license} — via Wikimedia Commons`}
      >
        © {imgCredit.author} · Wikimedia Commons
      </a>
    )}
    <!-- Type badge on image -->
    <span class={`absolute top-2.5 left-2.5 text-[10px] font-bold px-2 py-0.5 rounded-md tracking-wider backdrop-blur-sm ${isBreaking ? 'bg-gold text-pitch-900' : `bg-pitch-900/80 ${typeConfig.cls}`}`}>
      {isBreaking ? 'Breaking' : typeConfig.label}
    </span>
  </div>

  <div class="p-4 flex flex-col gap-3 flex-1 min-w-0">

    <!-- Club logos row — prominent -->
    {(fromClub || toClub) && (
      <div class="flex items-center gap-3 py-2 px-3 bg-pitch-600 rounded-lg border border-line-soft">
        {fromClub && (
          <div class="flex items-center gap-2 min-w-0">
            <ClubBadge name={fromClub} size="md" />
            <span class="text-xs font-semibold text-cream-muted truncate">{fromClub}</span>
          </div>
        )}
        {fromClub && toClub && (
          <svg class="w-4 h-4 text-gold flex-shrink-0 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        )}
        {toClub && (
          <div class="flex items-center gap-2 min-w-0">
            <ClubBadge name={toClub} size="md" />
            <span class="text-xs font-bold text-cream truncate">{toClub}</span>
          </div>
        )}
      </div>
    )}

    <!-- Title -->
    <a
      href={transfer.sourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      class={`font-bold leading-snug text-cream hover:text-gold transition-colors line-clamp-2 ${featured ? 'font-display text-2xl' : 'text-sm'}`}
    >
      {transfer.title}
    </a>

    <!-- Summary (~60 words from the source article) -->
    {hasSummary && (
      <p class={`text-cream-muted leading-relaxed ${featured ? 'text-sm line-clamp-4' : 'text-xs line-clamp-4'}`}>
        {transfer.summary}
      </p>
    )}

    <!-- Source attribution + stars + time -->
    <div class="flex items-center justify-between gap-2 mt-auto pt-2 border-t border-line-soft">
      <div class="flex items-center gap-2 min-w-0">
        <a
          href={transfer.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-gold hover:text-gold-400 hover:underline truncate"
          title={`Read full article on ${transfer.source}`}
        >
          {transfer.source}
        </a>
        <span class="text-line text-xs">|</span>
        <ReliabilityStars score={transfer.confidence} />
      </div>
      <time datetime={transfer.publishedAt} class="text-xs text-cream-dim flex-shrink-0">{ago}</time>
    </div>

  </div>
</article>
