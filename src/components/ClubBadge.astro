---
import { getClubMeta, clubInitials } from '../lib/clubs';
import { EXTRA_CREST_COLORS } from '../lib/crestColors';

interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg';
}
const { name, size = 'md' } = Astro.props;
const meta = getClubMeta(name);
// A crest SVG file exists for CLUB_META clubs and for the extra table-only clubs.
const extra = EXTRA_CREST_COLORS[name];
const hasCrest = !!meta || !!extra;
const label = meta?.short ?? extra?.short ?? clubInitials(name);
const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const sizeClass = { sm: 'w-6 h-6', md: 'w-9 h-9', lg: 'w-12 h-12' }[size];

// Fallback for any club we don't have a crest file for (e.g. a newly promoted
// team the live table returns): render an ORIGINAL shield in the same style,
// coloured deterministically from the name, so a badge is never a blank circle.
let hue = 0;
for (const c of name) hue = (hue * 31 + c.charCodeAt(0)) >>> 0;
hue = hue % 360;
const top = `hsl(${hue} 55% 42%)`;
const bot = `hsl(${hue} 55% 28%)`;
const fSize = label.length >= 4 ? 16 : label.length === 3 ? 19 : 23;
---

{hasCrest ? (
  <!-- Our OWN original emblem asset (public/crests/<slug>.svg). Not a real trademarked crest. -->
  <img
    src={`/crests/${slug}.svg`}
    alt={`${name} emblem`}
    class={`${sizeClass} flex-shrink-0 drop-shadow`}
    loading="lazy"
    decoding="async"
  />
) : (
  <svg viewBox="0 0 64 74" role="img" aria-label={`${name} emblem`} class={`${sizeClass} flex-shrink-0 drop-shadow`}>
    <defs>
      <linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={top} />
        <stop offset="1" stop-color={bot} />
      </linearGradient>
    </defs>
    <path d="M32 2 L60 11 V40 C60 57 47 68 32 72 C17 68 4 57 4 40 V11 Z"
          fill={`url(#bg-${slug})`} stroke="rgba(255,255,255,0.65)" stroke-width="2" />
    <path d="M4 24 H60 V33 H4 Z" fill="rgba(255,255,255,0.14)" />
    <circle cx="32" cy="12" r="2.4" fill="#ffffff" />
    <text x="32" y="52" text-anchor="middle" font-family="Georgia, serif" font-weight="700"
          font-size={fSize} letter-spacing="0.5" fill="#ffffff">{label}</text>
  </svg>
)}
