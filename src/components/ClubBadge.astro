---
import { getClubMeta, clubInitials } from '../lib/clubs';

interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg';
}
const { name, size = 'md' } = Astro.props;
const meta = getClubMeta(name);
const label = meta?.short ?? clubInitials(name);
const color = meta?.color ?? '#6b7280';
const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const r = parseInt(color.slice(1, 3), 16);
const g = parseInt(color.slice(3, 5), 16);
const b = parseInt(color.slice(5, 7), 16);

const sizeClass = { sm: 'w-6 h-6', md: 'w-9 h-9', lg: 'w-12 h-12' }[size];
const textSize  = { sm: 'text-[8px]', md: 'text-[11px]', lg: 'text-xs' }[size];
---

{meta ? (
  <!-- Our OWN original emblem asset (public/crests/<slug>.svg). Not a real trademarked crest. -->
  <img
    src={`/crests/${slug}.svg`}
    alt={`${name} emblem`}
    class={`${sizeClass} flex-shrink-0 drop-shadow`}
    loading="lazy"
    decoding="async"
  />
) : (
  <div
    class={`${sizeClass} flex-shrink-0 rounded-full flex items-center justify-center font-black tracking-tighter ${textSize}`}
    style={`background:rgba(${r},${g},${b},0.14);border:1.5px solid rgba(${r},${g},${b},0.45);color:${color}`}
    title={name}
  >
    {label}
  </div>
)}
